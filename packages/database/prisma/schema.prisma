generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  website     String?
  description String?
  type        String?
  country     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // resources   Resource[]

  @@index([name])
}
