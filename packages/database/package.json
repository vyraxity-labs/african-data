{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prisma": "prisma",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx seed.ts",
    "db:reset": "prisma migrate reset",
    "build": "prisma generate && prisma migrate deploy",
    "test:resource": "tsx src/test-resource.ts",
    "test:resource-link": "tsx src/test-resource-link.ts",
    "test:link-check": "tsx src/test-link-check.ts",
    "test:custom-field": "tsx src/test-custom-field.ts",
    "test:fixture": "tsx ../../fixtures/test-sample-fixture.ts",
    "test:csv-parser": "tsx src/test-csv-parser.ts",
    "test:csv-normalizer": "tsx src/test-csv-normalizer.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/adapter-ppg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/validation": "workspace:*",
    "csv-parse": "^7.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
